config clusterduckd 'settings'
	option enabled '0'
	option com_type 'USB'
	option com_path '/dev/ttyACM0'
	option region 'MY'
	option mqtt_enabled '1'
	option mqtt_server 'mqqt.server.com'
	option mqtt_port '1883'
	option mqtt_client_id 'clusterduck-concentrator'
	option mqtt_username ''
	option mqtt_password ''
	option mqtt_keepalive '60'
	option mqtt_use_tls '0'
	option mqtt_ca_cert_file ''
